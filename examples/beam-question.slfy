  "model": {
    "id": "beam-question",
    "title": "Simply supported beam: point load and UDL",
    "summary": "A 6 m simply supported beam with a 20 kN point load at 2 m from A and 5 kN/m over its whole span.",
    "units": "m",
    "question": {
      "text": "A simply supported beam of span 6 m carries a point load of 20 kN at 2 m from A and a uniformly distributed load of 5 kN/m over its whole length. Determine the reactions at A and B and the maximum bending moment.",
      "find": [
        "the reactions at A and B",
        "the maximum bending moment"
      ]
    },
    "parameters": [
      {
        "id": "L",
        "label": "Span",
        "symbol": "L",
        "value": 6,
        "min": 3,
        "max": 10,
        "step": 0.5,
        "unit": "m"
      },
      {
        "id": "P",
        "label": "Point load",
        "symbol": "P",
        "value": 20,
        "min": 0,
        "max": 50,
        "step": 1,
        "unit": "kN"
      },
      {
        "id": "a",
        "label": "Load position from A",
        "symbol": "a",
        "value": 2,
        "min": 0.5,
        "max": 5,
        "step": 0.5,
        "unit": "m"
      },
      {
        "id": "w",
        "label": "Distributed load",
        "symbol": "w",
        "value": 5,
        "min": 0,
        "max": 15,
        "step": 0.5,
        "unit": "kN/m"
      }
    ],

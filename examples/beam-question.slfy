    "calculations": [
      {
        "id": "W",
        "label": "Total distributed load",
        "symbol": "W",
        "formula": "w * L",
        "unit": "kN",
        "latex": "W = wL",
        "step": "Replace the distributed load by its total, acting at mid-span."
      },
      {
        "id": "R_B",
        "label": "Reaction at B",
        "symbol": "R_B",
        "formula": "(P * a + W * L / 2) / L",
        "unit": "kN",
        "latex": "R_B = \\frac{Pa + W L/2}{L}",
        "step": "Take moments about A to find R_B.",
        "answer": true
      },
      {
        "id": "R_A",
        "label": "Reaction at A",
        "symbol": "R_A",
        "formula": "P + W - R_B",
        "unit": "kN",
        "latex": "R_A = P + W - R_B",
        "step": "Resolve vertically to find R_A.",
        "answer": true
      },
      {
        "id": "M_max",
        "label": "Maximum bending moment",
        "symbol": "M_{max}",
        "formula": "R_A * a - w * a ^ 2 / 2",
        "unit": "kN·m",
        "latex": "M_{max} = R_A a - \\frac{w a^2}{2}",
        "step": "The shear force changes sign under the point load, so the bending moment is greatest there.",
        "answer": true
      }
    ],
    "charts": [
      {

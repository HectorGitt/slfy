          "at": "+x"
        },
        "direction": "-x",
        "length": 0.12
      },
      {
        "id": "crank_torque",
        "kind": "moment",
        "label": "T_in",
        "magnitude": "F_cut * r",
        "unit": "N·m",
        "anchor": {
          "part": "bull_gear",
          "at": "center"
        }
      }
    ],
    "calculations": [
      {
        "id": "phi_deg",
        "label": "Lever Swing Half-Angle",
        "symbol": "φ",
        "formula": "asin(r / c) * 180 / pi",
        "unit": "deg"
      },
      {
        "id": "qrr",
        "label": "Quick-Return Ratio",
        "symbol": "QRR",
        "formula": "(180 + 2 * asin(r / c) * 180 / pi) / (180 - 2 * asin(r / c) * 180 / pi)",
        "unit": ""
      },
      {
        "id": "stroke",
        "label": "Ram Stroke Length",
        "symbol": "S",
        "formula": "2 * L_lever * (r / c)",
        "unit": "m"
      },
      {
        "id": "v_cut_avg",
        "label": "Mean Cutting Speed",
        "symbol": "V_cut",
        "formula": "(2 * L_lever * (r / c)) / ((180 + 2 * asin(r / c) * 180 / pi) / 360 * (60 / speed))",
        "unit": "m/s"
      },
      {
        "id": "v_ret_avg",
        "label": "Mean Return Speed",
        "symbol": "V_ret",
        "formula": "(2 * L_lever * (r / c)) / ((180 - 2 * asin(r / c) * 180 / pi) / 360 * (60 / speed))",
        "unit": "m/s"
      },
      {
        "id": "P_cut",
        "label": "Cutting Power",
        "symbol": "P",
        "formula": "F_cut * ((2 * L_lever * (r / c)) / ((180 + 2 * asin(r / c) * 180 / pi) / 360 * (60 / speed))) / 1000",
        "unit": "kW"
      }
    ],
    "charts": [
      {
        "id": "velocity_diagram",
        "title": "Ram Linear Velocity vs Crank Angle",
        "x": {
          "label": "Crank Angle",
          "unit": "deg",
          "from": "0",
          "to": "360"
        },
        "y": {
          "label": "Ram Velocity",
          "unit": "m/s"
        },
        "series": [
          {
            "id": "v_ram",
            "label": "Velocity v(θ)",
            "formula": "2 * pi * (speed / 60) * r * (L_lever / c) * sin(x * pi / 180) / (1 - (r / c) * cos(x * pi / 180))^1.5"
          }
        ]
      },
      {
        "id": "displacement_diagram",
        "title": "Ram Position vs Crank Angle",
        "x": {
          "label": "Crank Angle",
          "unit": "deg",
          "from": "0",
          "to": "360"
        },
        "y": {
          "label": "Displacement",
          "unit": "m"
        },
        "series": [
          {
            "id": "s_ram",
            "label": "Displacement s(θ)",
            "formula": "(stroke / 2) * (1 - cos(x * pi / 180 - asin(r / c) * sin(x * pi / 180)))"
          }
        ]
      }
    ]

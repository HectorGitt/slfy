    "annotations": [
      {
        "id": "stroke_dim",
        "kind": "dimension",
        "label": "Stroke S",
        "magnitude": "stroke",
        "unit": "m",
        "from": [
          "0.06 + 0.25 - stroke / 2",
          "(L_lever - c + 0.04) + 0.12",
          -0.06
        ],
        "to": [
          "0.06 + 0.25 + stroke / 2",
          "(L_lever - c + 0.04) + 0.12",
          -0.06
        ]
      },

    "annotations": [
      {
        "id": "in_torque",
        "kind": "moment",
        "label": "T_in",
        "magnitude": "P_in * 1000 * 60 / (2 * pi * n_in)",
        "unit": "N·m",
        "anchor": {
          "part": "worm_shaft",
          "at": "end"
        }
      },
      {
        "id": "out_torque",
        "kind": "moment",
        "label": "T_out",
        "magnitude": "T_out",
        "unit": "N·m",
        "anchor": {
          "part": "output_shaft",
          "at": "end"
        }
      }
    ],
    "calculations": [
      {
        "id": "ratio",
        "label": "Gear ratio",
        "symbol": "i",
        "formula": "z2 / z1",
        "unit": ":1",
        "latex": "i = \\frac{z_2}{z_1}"
      },
      {
        "id": "n_out",
        "label": "Output speed",
        "symbol": "n_{out}",
        "formula": "n_in / (z2 / z1)",
        "unit": "rpm",
        "latex": "n_{out} = \\frac{n_{in}}{i}"
      },
      {
        "id": "gamma_deg",
        "label": "Lead angle",
        "symbol": "\\gamma",
        "formula": "atan(z1 / q) * 180 / pi",
        "unit": "°",
        "latex": "\\gamma = \\arctan\\left(\\frac{z_1}{q}\\right)"
      },
      {
        "id": "eta",
        "label": "Efficiency",
        "symbol": "\\eta",
        "formula": "tan(atan(z1 / q)) / tan(atan(z1 / q) + 0.08)",
        "unit": "",
        "latex": "\\eta \\approx \\frac{\\tan\\gamma}{\\tan(\\gamma + \\rho)}"
      },
      {
        "id": "T_out",
        "label": "Output torque",
        "symbol": "T_{out}",
        "formula": "(P_in * 1000 * 60 / (2 * pi * (n_in / (z2 / z1)))) * (tan(atan(z1 / q)) / tan(atan(z1 / q) + 0.08))",
        "unit": "N·m",
        "latex": "T_{out} = \\frac{P_{in}\\eta}{\\omega_{out}}"
      }
    ],
    "charts": [
      {
        "id": "efficiency_curve",
        "title": "Efficiency vs Lead Angle",
        "x": {
          "label": "Lead angle",
          "unit": "°",
          "from": "2",
          "to": "40"
        },
        "y": {
          "label": "Efficiency",
          "unit": "%"
        },
        "series": [
          {
            "id": "eta_series",
            "label": "η (%)",
            "formula": "100 * tan(x * pi / 180) / tan((x + 4.5) * pi / 180)"
          }
        ]
      }
    ]

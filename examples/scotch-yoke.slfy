    "calculations": [
      {
        "id": "stroke",
        "label": "Total Stroke",
        "symbol": "S",
        "formula": "2 * r",
        "unit": "m",
        "latex": "S = 2r"
      },
      {
        "id": "omega",
        "label": "Angular Velocity",
        "symbol": "\\omega",
        "formula": "2 * pi * rpm / 60",
        "unit": "rad/s",
        "latex": "\\omega = \\frac{2\\pi n}{60}"
      },
      {
        "id": "v_max",
        "label": "Peak Linear Velocity",
        "symbol": "v_{\\max}",
        "formula": "omega * r",
        "unit": "m/s",
        "latex": "v_{\\max} = \\omega r"
      },
      {
        "id": "a_max",
        "label": "Peak Acceleration",
        "symbol": "a_{\\max}",
        "formula": "omega^2 * r",
        "unit": "m/s^2",
        "latex": "a_{\\max} = \\omega^2 r"
      }
    ],

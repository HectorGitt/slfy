        "id": "stroke_dim",
        "kind": "dimension",
        "label": "Stroke",
        "magnitude": "stroke",
        "unit": "m",
        "from": [
          "-r",
          "r + 0.085",
          0.03
        ],
        "to": [
          "r",
          "r + 0.085",
          0.03
        ]
      },
      {
        "id": "torque_in",
        "kind": "moment",
        "label": "T_in",
        "anchor": {
          "part": "crank",
          "at": "start"
        }
      }
    ],
    "calculations": [
      {
        "id": "stroke",
        "label": "Total Stroke",
        "symbol": "S",
        "formula": "2 * r",
        "unit": "m",
        "latex": "S = 2r"
      },
      {
        "id": "omega",
        "label": "Angular Velocity",
        "symbol": "\\omega",
        "formula": "2 * pi * rpm / 60",
        "unit": "rad/s",
        "latex": "\\omega = \\frac{2\\pi n}{60}"
      },
      {
        "id": "v_max",
        "label": "Peak Linear Velocity",
        "symbol": "v_{\\max}",
        "formula": "omega * r",
        "unit": "m/s",
        "latex": "v_{\\max} = \\omega r"
      },
      {
        "id": "a_max",
        "label": "Peak Acceleration",
        "symbol": "a_{\\max}",
        "formula": "omega^2 * r",
        "unit": "m/s^2",
        "latex": "a_{\\max} = \\omega^2 r"
      }
    ],
    "charts": [
      {
        "id": "kinematics",
        "title": "Scotch Yoke Displacement & Velocity vs Crank Angle",
        "x": {
          "label": "Crank Angle",
          "unit": "rad",
          "from": "0",
          "to": "2 * pi"
        },
        "y": {
          "label": "Displacement & Norm. Velocity",
          "unit": "m"
        },
        "series": [
          {
            "id": "disp",
            "label": "Displacement x(\\theta) [m]",
            "formula": "r * cos(x)"
          },
          {
            "id": "vel",
            "label": "Velocity v/\\omega [m]",
            "formula": "-r * sin(x)"
          }
        ]
      }

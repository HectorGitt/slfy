    "annotations": [
      {
        "id": "ann_torque",
        "kind": "moment",
        "label": "T_1",
        "magnitude": "T1",
        "unit": "N·m",
        "anchor": {
          "part": "pinion_shaft",
          "at": "start"
        }
      },
      {
        "id": "ann_thrust",
        "kind": "force",
        "label": "F_a",
        "magnitude": "Fa",
        "unit": "N",
        "anchor": {
          "part": "pinion",
          "at": "+x"
        },
        "direction": "+z",
        "length": 0.1
      },
      {
        "id": "ann_tangential",
        "kind": "force",
        "label": "F_t",
        "magnitude": "Ft",
        "unit": "N",
        "anchor": {
          "part": "pinion",
          "at": "+x"
        },
        "direction": "-y",
        "length": 0.12
      }
    ],
    "calculations": [
      {
        "id": "u",
        "label": "Gear ratio",
        "symbol": "u",
        "formula": "z2 / z1",
        "unit": "",
        "latex": "u = \\frac{z_2}{z_1}"
      },
      {
        "id": "mt",
        "label": "Transverse module",
        "symbol": "m_t",
        "formula": "mn / cos(beta * pi / 180)",
        "unit": "mm",
        "latex": "m_t = \\frac{m_n}{\\cos\\beta}"
      },
      {
        "id": "d1",
        "label": "Pinion pitch diameter",
        "symbol": "d_1",
        "formula": "z1 * mt",
        "unit": "mm",
        "latex": "d_1 = z_1 m_t"
      },
      {
        "id": "d2",
        "label": "Wheel pitch diameter",
        "symbol": "d_2",
        "formula": "z2 * mt",
        "unit": "mm",
        "latex": "d_2 = z_2 m_t"
      },
      {
        "id": "a",
        "label": "Center distance",
        "symbol": "a",
        "formula": "(d1 + d2) / 2",
        "unit": "mm",
        "latex": "a = \\frac{d_1 + d_2}{2}"
      },
      {
        "id": "T1",
        "label": "Pinion torque",
        "symbol": "T_1",
        "formula": "power * 1000 / (2 * pi * rpm1 / 60)",
        "unit": "N·m",
        "latex": "T_1 = \\frac{P}{\\omega_1}"
      },
      {
        "id": "Ft",
        "label": "Tangential tooth force",
        "symbol": "F_t",
        "formula": "2000 * T1 / d1",
        "unit": "N",
        "latex": "F_t = \\frac{2 T_1}{d_1}"
      },
      {
        "id": "Fa",
        "label": "Axial thrust force",
        "symbol": "F_a",
        "formula": "Ft * tan(beta * pi / 180)",
        "unit": "N",
        "latex": "F_a = F_t \\tan\\beta"
      }
    ],
    "charts": [
      {
        "id": "thrust_vs_beta",
        "title": "Axial Thrust Force vs Helix Angle",
        "x": {
          "label": "Helix angle β",
          "unit": "deg",
          "from": "10",
          "to": "35"
        },
        "y": {
          "label": "Thrust Force Fa",
          "unit": "N"
        },
        "series": [
          {
            "id": "fa_curve",
            "label": "Axial Force Fa(β)",
            "formula": "Ft * tan(x * pi / 180)"
          }
        ]
      }
    ]

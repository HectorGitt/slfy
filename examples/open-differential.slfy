    "calculations": [
      {
        "id": "final_drive_ratio",
        "label": "Final drive ratio",
        "symbol": "i_fd",
        "formula": "N_ring / N_pinion",
        "unit": "",
        "latex": "i_{fd} = \\frac{z_r}{z_p}"
      },
      {
        "id": "n_left",
        "label": "Left axle speed",
        "symbol": "n_L",
        "formula": "input_rpm - delta_rpm / 2",
        "unit": "rpm",
        "latex": "n_L = n_c - \\frac{\\Delta n}{2}"
      },
      {
        "id": "n_right",
        "label": "Right axle speed",
        "symbol": "n_R",
        "formula": "input_rpm + delta_rpm / 2",
        "unit": "rpm",
        "latex": "n_R = n_c + \\frac{\\Delta n}{2}"
      },
      {
        "id": "torque_per_wheel",
        "label": "Axle torque per side",
        "symbol": "T_axle",
        "formula": "input_torque / 2",
        "unit": "N·m",
        "latex": "T_{axle} = \\frac{T_{in}}{2}"
      },
      {
        "id": "spider_spin",
        "label": "Spider relative spin",
        "symbol": "n_spider",
        "formula": "abs(delta_rpm) * (N_side / N_spider) / 2",
        "unit": "rpm",
        "latex": "n_s = \\frac{|\\Delta n|}{2} \\cdot \\frac{z_a}{z_s}"
      }
    ],
    "charts": [
      {
        "id": "axle_speeds",
        "title": "Left and Right Axle Speeds vs Speed Difference",
        "x": {
          "label": "Wheel speed differential Δn",
          "unit": "rpm",
          "from": "-150",
          "to": "150"
        },
        "y": {
          "label": "Axle speed",
          "unit": "rpm"
        },
        "series": [
          {
            "id": "s_left",
            "label": "Left axle speed (n_L)",
            "formula": "input_rpm - x / 2"
          },
          {
            "id": "s_right",
            "label": "Right axle speed (n_R)",
            "formula": "input_rpm + x / 2"
          }
        ]
      }

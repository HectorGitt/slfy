    "annotations": [
      {
        "id": "ann_torque_in",
        "kind": "moment",
        "label": "T_in",
        "magnitude": "input_torque",
        "unit": "N·m",
        "anchor": {
          "part": "ring_gear",
          "at": "center"
        }
      },
      {
        "id": "ann_t_left",
        "kind": "moment",
        "label": "T_L",
        "magnitude": "torque_per_wheel",
        "unit": "N·m",
        "anchor": {
          "part": "side_gear_left",
          "at": "start"
        }
      },
      {
        "id": "ann_t_right",
        "kind": "moment",
        "label": "T_R",
        "magnitude": "torque_per_wheel",

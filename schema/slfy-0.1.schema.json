                },
                "shift": {
                  "$ref": "#/$defs/__schema4"
                }
              },
              "required": [
                "kind",
                "target"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "const": "mesh"
                },
                "target": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 80
                },
                "side": {
                  "$ref": "#/$defs/__schema6"
                },
                "angle": {
                  "$ref": "#/$defs/__schema5"
                },
                "shift": {
                  "$ref": "#/$defs/__schema4"
                }
              },

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/HectorGitt/slfy/main/schema/slfy-0.1.schema.json",
  "title": "Solidify model file (.slfy) 0.1",
  "description": "A 3D engineering model that moves and calculates: parameters, parts placed by relation, motion, annotations, live calculations, charts and the question it answers. See format/SPEC.md.",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "format": {
      "type": "string",
      "const": "slfy"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+$"
    },
    "model": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "summary": {
          "type": "string",
          "maxLength": 1000
        },
        "units": {
          "type": "string",
          "enum": [
            "mm",
            "m"
          ],
          "description": "the unit sliders show sizes in; geometry is always in metres"
        },
        "question": {
          "description": "a problem being solved: its givens are the parameters, its worked solution the calculations, in order",
          "$ref": "#/$defs/__schema0"
        },
        "parameters": {
          "maxItems": 20,
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema2"
          }
        },
        "parts": {
          "minItems": 1,
          "maxItems": 32,
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema3"
          }
        },
        "annotations": {
          "maxItems": 24,
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema10"
          }
        },
        "calculations": {
          "maxItems": 20,
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema11"
          }
        },
        "charts": {
          "maxItems": 6,
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema12"
          }
        }
      },
      "required": [
        "id",
        "title",
        "summary",
        "units",
        "parameters",
        "parts"
      ],
      "additionalProperties": false
    },
    "view": {
      "type": "object",
      "properties": {
        "camera": {
          "type": "object",
          "properties": {
            "position": {
              "$ref": "#/$defs/__schema14"
            },
            "target": {
              "$ref": "#/$defs/__schema14"
            }
          },
          "required": [
            "position",
            "target"
          ],
          "additionalProperties": false
        },
        "extent": {
          "description": "the size of the scene in metres, for framing and the floor grid",
          "$ref": "#/$defs/__schema15"
        },
        "floorY": {
          "description": "height of the floor, metres",
          "$ref": "#/$defs/__schema16"
        },
        "cut": {
          "description": "the cut-away the model opens with",
          "$ref": "#/$defs/__schema17"
        },
        "projectionPlanes": {
          "type": "string",
          "enum": [
            "none",
            "first-angle",
            "third-angle"
          ]
        }
      },
      "additionalProperties": false
    },
    "meta": {
      "type": "object",
      "properties": {
        "generator": {
          "type": "string",
          "maxLength": 120
        },
        "created": {
          "type": "string",
          "maxLength": 40
        },
        "license": {
          "type": "string",
          "maxLength": 80
        },
        "source": {
          "type": "string",
          "maxLength": 400
        }
      },
      "additionalProperties": false
    },
    "extensions": {
      "description": "namespaced additions (\"vendor.feature\"); readers ignore what they do not know",
      "$ref": "#/$defs/__schema18"
    }
  },
  "required": [
    "format",
    "version",
    "model"
  ],
  "additionalProperties": false,
  "$defs": {
    "__schema0": {
      "type": "object",
      "properties": {
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        "find": {
          "maxItems": 8,
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema1"
          }
        },
        "symbolic": {
          "type": "boolean"
        }
      },
      "required": [
        "text",
        "find"
      ],
      "additionalProperties": false
    },
    "__schema1": {
      "type": "string",
      "maxLength": 300
    },
    "__schema2": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "symbol": {
          "type": "string",
          "maxLength": 30
        },
        "value": {
          "type": "number"
        },
        "min": {
          "type": "number"
        },
        "max": {
          "type": "number"
        },
        "step": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "unit": {
          "type": "string",
          "maxLength": 24
        }
      },
      "required": [
        "id",
        "label",
        "value",
        "min",
        "max",
        "step",
        "unit"
      ],
      "additionalProperties": false
    },
    "__schema3": {
